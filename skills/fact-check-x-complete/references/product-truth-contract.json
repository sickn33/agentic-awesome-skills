{
  "schemaVersion": "fact-check-x/product-truth@1",
  "minimumPlatforms": 1,
  "stageArtifacts": [
    "capture/results.json",
    "capture-gate.json",
    "comparison-task.json",
    "comparison-analysis.json",
    "comparison.json",
    "comparison-gate.json",
    "authority-gate.json",
    "authority/requests/manifest.json",
    "authority/evidence/batch.json",
    "verification.json",
    "pipeline.json",
    "report-input/legacy-analysis.json",
    "01-capture-report.html",
    "02-comparison-report.html",
    "03-authority-report.html",
    "04-final-report.html",
    "05-complete-report-package.zip"
  ],
  "conservation": {
    "platforms": "capture/results.json -> comparison.json -> verification.json",
    "knowledgePoints": "comparison-analysis.json -> comparison.json -> verification.json",
    "synthesisDraft": "comparison-analysis.json -> comparison.json -> 02-comparison-report.html",
    "finalAnswer": "authority/results/*.json -> verification.json -> 03-authority-report.html",
    "claimFields": ["covered", "claim", "answerExcerpt", "faithfulness", "evidence"],
    "pointFields": ["comparison", "trustedAnchor"],
    "onMissing": "repair_or_retry_same_stage_else_block"
  },
  "stageInteraction": {
    "default": "deliver_openable_artifact_then_wait_for_user",
    "choices": [
      "继续下一步",
      "修正当前结果",
      "到此结束并保留产物"
    ],
    "autoRunOnlyWhenInitiallyExplicit": true,
    "autoRunStillEmitsCheckpoints": true,
    "hardGatesAlwaysApply": true
  },
  "trustedSearch": {
    "displayLabel": "官方来源",
    "directAccurateWhen": [
      "platform_is_dknowc_chat",
      "reference_has_valid_http_url",
      "reference_captured_text_is_locatable",
      "claim_answer_excerpt_locatable",
      "claim_faithfulness_supported",
      "official_evidence_excerpt_locatable"
    ],
    "dknowReferenceScope": "external_official_url_or_dknow_internal_collection_url",
    "skipSecondarySearchWhen": "trustedAnchor.eligible=true"
  },
  "browserLifecycle": [
    "logged_in",
    "logged_out",
    "page_retained",
    "page_closed_then_reopened",
    "original_question_replayed_after_recovery"
  ],
  "layout": {
    "sourceMatrixTextAlign": "center",
    "sourceMatrixTitleColumnPercent": 50,
    "remainingColumns": "equal_share"
  }
}
